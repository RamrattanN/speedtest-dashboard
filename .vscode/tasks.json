{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup project",
      "type": "shell",
      "command": "python3 -m venv .venv && .venv/bin/python -m pip install --upgrade pip && .venv/bin/python -m pip install -e '.[test]'",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Run automated tests",
      "type": "shell",
      "command": ".venv/bin/python -m pytest -q",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "dependsOn": "Setup project"
    },
    {
      "label": "Start Speedtest Dashboard",
      "type": "shell",
      "command": "./RunSpeedTest.command --interval 300",
      "problemMatcher": []
    }
  ]
}
